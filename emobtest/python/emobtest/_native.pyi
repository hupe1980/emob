__version__: str

class Meter:
    def __init__(self, seed: int = 0, index: int = 0, stream: str = "emobtest") -> None: ...
    @property
    def public_key(self) -> str: ...
    @property
    def evse(self) -> str: ...
    @property
    def serial(self) -> str: ...
    def sign(self, page: int, marker: str, at: str, kwh: str) -> str: ...
    def charge(self, kwh: str, start: str, minutes: int) -> list[str]: ...

def verify(record: str, key: str) -> tuple[int, str]: ...
def evidence(records: list[str], key: str) -> tuple[bool, bool, str | None, list[str]]: ...
def tariff_total(spec: str, kwh: str, power_kw: str, at: str) -> str: ...
def tariff_lines(spec: str, at: str) -> list[tuple[str, str, str]]: ...
def tariff_version(spec: str) -> tuple[str, str]: ...
def evse_id(text: str) -> str: ...
def emaid(text: str) -> str: ...
def event_types() -> list[str]: ...
def event_errors(text: str) -> list[str]: ...
def feed_report(bytes: bytes) -> tuple[list[str], list[str | None]]: ...

class NativeStation:
    def __init__(
        self,
        url: str,
        identity: str,
        password: str,
        ocpp: str,
        ca: str | None = None,
        seed: int = 0,
        index: int = 1,
        stream: str = "emobtest",
    ) -> None: ...
    @property
    def meter_key(self) -> str: ...
    @property
    def meter_serial(self) -> str: ...
    @property
    def display(self) -> list[str]: ...
    @property
    def reservations(self) -> list[tuple[int, str, str]]: ...
    @property
    def asked(self) -> list[str]: ...
    def charge(
        self,
        card: str,
        minutes: int,
        battery_wh: int,
        soc: int,
        target_soc: int,
        max_amps: int,
        phases: int,
        fault: str,
    ) -> tuple[str, str, str, list[str]]: ...
    def close(self) -> None: ...
